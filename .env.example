# ============================================================
# Supabase — public keys
# Sent to the browser. Copy this file to .env.local and fill in.
# Dashboard > Project Settings > API
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ============================================================
# Supabase — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
#
# This key BYPASSES ALL ROW LEVEL SECURITY. Treat it like a root password.
#
# Required by:
#   src/app/api/auth/check-email/route.js   (POST — block duplicate sign-ups)
#   src/app/api/staff/route.js                (POST — create staff account)
#   src/app/api/staff/reset-password/route.js (POST — reset a password)
#
# Without it those routes return an explicit 500 explaining what is missing.
#
# Get it at: Dashboard > Project Settings > API > Project API keys > service_role
# On Vercel, set it with `vercel env add SUPABASE_SERVICE_ROLE_KEY` for each
# environment — never paste it into vercel.json or any committed file.
# ============================================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
